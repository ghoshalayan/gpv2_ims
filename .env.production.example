# Production .env template — copy to .env on the server and fill in real values.
# This file lives ABOVE the web root (e.g. /home/<cpaneluser>/gpv2_ims/.env) so it
# is never web-accessible. NEVER commit the real .env.

APP_NAME="GP ENTERPRISE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ims.srasingerkone.org

# cPanel MySQL: names are prefixed with your account, e.g. srasing_gpv2ims.
# DB_HOST stays 'localhost' on shared hosting (the DB runs on the same box).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANELUSER_gpv2ims

# Multi-tenancy (optional). Leave UNSET for a normal single-business install —
# the app then uses DB_NAME above and behaves exactly as it always has.
# Set it to the control database to turn multi-tenancy on; see MULTI-TENANCY.md.
# CONTROL_DB_NAME=srasinge1_control
DB_USER=CPANELUSER_gpv2
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_NAME=gpv2_session
SESSION_LIFETIME_MINUTES=120

# Keep logging quiet in production. storage/logs/ must be writable by PHP.
LOG_LEVEL=error
LOG_PATH=storage/logs/app.log
