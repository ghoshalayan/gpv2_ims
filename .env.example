# Copy this file to .env and fill in real values.
# .env must NEVER be committed to source control.

APP_NAME="IMS v2.0"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/gpv2

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gpv2_ims

# Multi-tenancy (optional). Leave UNSET for a normal single-business install —
# the app then uses DB_NAME above and behaves exactly as it always has.
# Set it to the control database to turn multi-tenancy on; see MULTI-TENANCY.md.
# CONTROL_DB_NAME=srasinge1_control
DB_USER=root
DB_PASSWORD=root

SESSION_NAME=gpv2_session
SESSION_LIFETIME_MINUTES=120

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
