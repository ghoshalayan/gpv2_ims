# Copy this file to .env and fill in real values.
# .env must NEVER be committed to source control.

APP_NAME="GP ENTERPRISE"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/gpv2

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gpv2_ims
DB_USER=root
DB_PASSWORD=root

SESSION_NAME=gpv2_session
SESSION_LIFETIME_MINUTES=120

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
